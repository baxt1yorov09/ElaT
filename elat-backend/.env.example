# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API from browsers (admin, web payment redirect)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS). Scheme must be postgis:// for GeoDjango.
# ---------------------------------------------------------------------------
DATABASE_URL=postgis://elat:elat@db:5432/elat

# ---------------------------------------------------------------------------
# Redis (cache, channels, celery broker/result)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: MinIO in dev, in-country cloud in prod).
# All infra endpoints are env-driven so hosting can be relocated (see DECISIONS D10).
# ---------------------------------------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=elatminio
AWS_SECRET_ACCESS_KEY=elatminio-secret
AWS_STORAGE_BUCKET_NAME=elat-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# ---------------------------------------------------------------------------
# SMS provider (Eskiz/Playmobile in prod; "console" prints codes to logs in dev)
# ---------------------------------------------------------------------------
SMS_PROVIDER=console
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_ESKIZ_BASE_URL=https://notify.eskiz.uz/api
SMS_SENDER=4546
# Operator codes allowed after +998 (comma-separated). SPEC §18.1.
UZ_PHONE_OPERATOR_CODES=20,33,50,55,77,88,90,91,93,94,95,97,98,99

# ---------------------------------------------------------------------------
# Payments (Phase 3). Per-platform purchase flags live in app remote config.
# ---------------------------------------------------------------------------
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# ---------------------------------------------------------------------------
# Observability (Phase 5)
# ---------------------------------------------------------------------------
SENTRY_DSN=
